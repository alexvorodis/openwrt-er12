#!/bin/sh /etc/rc.common
# er12-linksync init — per-port link sync daemon (procd-managed)

START=99
STOP=10
USE_PROCD=1

DAEMON=/usr/lib/er12/er12-linksync.sh

start_service() {
	[ -x "$DAEMON" ] || return 0
	[ "$(uci -q get linksync.general.enabled)" = "0" ] && return 0

	procd_open_instance
	procd_set_param command /bin/sh "$DAEMON"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	pgrep -f er12-linksync.sh | while read -r p; do kill "$p" 2>/dev/null; done
}
